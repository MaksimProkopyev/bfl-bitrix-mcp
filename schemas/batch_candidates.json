            "enum": ["forum", "city", "vk", "tg", "ok", "qna", "video", "ugc"]
          },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "posted_at": { "type": "string", "format": "date-time" },
          "region": { "type": ["string", "null"] },
          "debt_estimate_rub": { "type": ["number", "null"] },
          "contact": {
            "type": "object",
            "properties": {
